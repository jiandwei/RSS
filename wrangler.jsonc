{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scholar-rss",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "FEED_STORE", "class_name": "FeedStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedStore"] }],
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "FEED_TITLE": "Economists — Research Updates",
    "MAX_FEED_ITEMS": "200",
    "MAX_HISTORY_ITEMS": "2000"
  }
}

